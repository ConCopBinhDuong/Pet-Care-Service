# ### Service Submission with License Tests
# ### Tests for service providers to submit services with license documents
# ### Make sure server is running on HTTPS (port 8443)

# @baseUrl = https://localhost:8443/api
# @serviceProviderEmail = service.provider@example.com
# @serviceProviderPassword = SecurePass123!
# @managerEmail = manager@petcare.com 
# @managerPassword = AdminPass123!

# # ===================================================================
# # AUTHENTICATION - Get tokens for testing
# # ===================================================================

# ### 1. Login as Service Provider
# POST {{baseUrl}}/auth/login
# Content-Type: application/json

# {
#     "email": "{{serviceProviderEmail}}",
#     "password": "{{serviceProviderPassword}}"
# }

# ### 2. Login as Manager  
# POST {{baseUrl}}/auth/login
# Content-Type: application/json

# {
#     "email": "{{managerEmail}}",
#     "password": "{{managerPassword}}"
# }

# # ===================================================================
# # SERVICE SUBMISSION WITH LICENSE TESTS
# # ===================================================================

# ### 3. Submit Service with License (PDF Document)
# POST {{baseUrl}}/services
# Authorization: Bearer {{serviceProviderToken}}
# Content-Type: application/json

# {
#     "name": "Professional Pet Grooming with License",
#     "price": 200000,
#     "description": "Premium grooming service with certified professional license and insurance coverage",
#     "duration": "2.5 hours",
#     "typeid": 2,
#     "license": "data:application/pdf;base64,",
#     "timeSlots": ["08:00", "10:00", "13:00", "15:00", "17:00"]
# }

# ### 4. Submit Service with License (Image Document - JPEG)
# POST {{baseUrl}}/services/submit
# Authorization: Bearer {{serviceProviderToken}}
# Content-Type: application/json

# {
#     "name": "Veterinary Care Services",
#     "price": 350000,
#     "description": "Licensed veterinary care including check-ups, vaccinations, and minor treatments",
#     "duration": "1 hour",
#     "typeid": 3,
#     "license": "data:image/jpeg;base64,",
#     "timeSlots": ["09:00", "11:00", "14:00", "16:00"]
# }

# ### 5. Submit Service WITHOUT License (Should work but license will be null)
# POST {{baseUrl}}/services
# Authorization: Bearer {{serviceProviderToken}}
# Content-Type: application/json

# {
#     "name": "Basic Pet Walking Service",
#     "price": 50000,
#     "description": "Simple dog walking service for busy pet owners",
#     "duration": "30 minutes",
#     "typeid": 1,
#     "timeSlots": ["07:00", "18:00", "19:00"]
# }

# # ===================================================================
# # MANAGER REVIEW WITH LICENSE VISIBILITY TESTS
# # ===================================================================

# ### 6. Get All Pending Services for Review (Manager) - Should show license
# GET {{baseUrl}}/services/pending-review
# Authorization: Bearer {{managerToken}}

# ### 7. Get Service Provider's Services (Should show license to provider)
# GET {{baseUrl}}/services/my-services
# Authorization: Bearer {{serviceProviderToken}}

# ### 7.5. Get Complete Service Details for Manager Review (Manager Only)
# GET {{baseUrl}}/services/1/manager-details
# Authorization: Bearer {{managerToken}}

# ### 8. Get Service Provider's Pending Services Only
# GET {{baseUrl}}/services/my-services?status=pending
# Authorization: Bearer {{serviceProviderToken}}

# # ===================================================================
# # SERVICE APPROVAL TESTS
# # ===================================================================

# ### 9. Approve Service with License
# POST {{baseUrl}}/services/1/review
# Authorization: Bearer {{managerToken}}
# Content-Type: application/json

# {
#     "action": "approve"
# }

# ### 10. Reject Service (Example)
# POST {{baseUrl}}/services/2/review
