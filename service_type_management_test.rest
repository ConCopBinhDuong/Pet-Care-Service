# ===================================================================
# SERVICE TYPE MANAGEMENT API TESTS
# ===================================================================
# Tests for service type initialization and creation during service submission
# Base URL: https://localhost:8443/api
# ===================================================================

@baseUrl = https://localhost:8443/api
@serviceProviderToken = 
@managerToken = 
@petOwnerToken = 

# ===================================================================
# SERVICE TYPE INITIALIZATION (Service Provider Only)
# ===================================================================

### 1. Initialize Service Types - Service Provider (ALLOWED)
POST {{baseUrl}}/services/initialize
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "serviceTypes": [
        { "type": "Pet Grooming" },
        { "type": "Pet Training" },
        { "type": "Pet Sitting" },
        { "type": "Veterinary Care" },
        { "type": "Pet Boarding" }
    ]
}

### 2. Initialize Service Types - Manager (DENIED)
POST {{baseUrl}}/services/initialize
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
    "serviceTypes": [
        { "type": "Pet Grooming" },
        { "type": "Pet Training" }
    ]
}

### 3. Initialize Service Types - Pet Owner (DENIED)
POST {{baseUrl}}/services/initialize
Authorization: Bearer {{petOwnerToken}}
Content-Type: application/json

{
    "serviceTypes": [
        { "type": "Pet Grooming" }
    ]
}

### 4. Initialize Service Types - No Auth (DENIED)
POST {{baseUrl}}/services/initialize
Content-Type: application/json

{
    "serviceTypes": [
        { "type": "Pet Grooming" }
    ]
}

# ===================================================================
# SERVICE SUBMISSION WITH NEW SERVICE TYPE
# ===================================================================

### 5. Submit Service with New Service Type - Service Provider (ALLOWED)
POST {{baseUrl}}/services
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Mobile Pet Grooming",
    "price": 200000,
    "description": "Professional grooming service at your doorstep",
    "duration": "1.5 hours",
    "serviceType": "Mobile Grooming",
    "license": "data:application/pdf;base64,",
    "timeSlots": ["09:00", "11:00", "14:00", "16:00"]
}

### 6. Submit Service with Existing Service Type ID - Service Provider (ALLOWED)
POST {{baseUrl}}/services
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Basic Pet Grooming",
    "price": 100000,
    "description": "Standard grooming service including bath and nail trim",
    "duration": "1 hour",
    "typeid": 1,
    "timeSlots": ["10:00", "12:00", "15:00"]
}

### 7. Submit Service with Both TypeID and ServiceType - Service Provider (DENIED)
POST {{baseUrl}}/services
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Deluxe Pet Grooming",
    "price": 250000,
    "description": "Deluxe grooming service with premium products",
    "duration": "2 hours",
    "typeid": 1,
    "serviceType": "Premium Grooming",
    "timeSlots": ["09:00", "13:00"]
}

### 8. Submit Service with Neither TypeID nor ServiceType - Service Provider (DENIED)
POST {{baseUrl}}/services
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Express Pet Grooming",
    "price": 80000,
    "description": "Quick grooming service for busy pet owners",
    "duration": "30 minutes",
    "timeSlots": ["08:00", "12:00", "17:00"]
}

### 9. Submit Service with Empty ServiceType - Service Provider (DENIED)
POST {{baseUrl}}/services
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Quick Pet Grooming",
    "price": 75000,
    "description": "Fast grooming service",
    "duration": "45 minutes",
    "serviceType": "",
    "timeSlots": ["09:00", "14:00"]
}

### 10. Submit Service with Short ServiceType Name - Service Provider (DENIED)
POST {{baseUrl}}/services
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Pet Service",
    "price": 50000,
    "description": "General pet service",
    "duration": "1 hour",
    "serviceType": "Ab",
    "timeSlots": ["10:00", "15:00"]
}

### 11. Submit Service with Long ServiceType Name - Service Provider (DENIED)
POST {{baseUrl}}/services
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Comprehensive Pet Service",
    "price": 300000,
    "description": "Complete pet care service package",
    "duration": "3 hours",
    "serviceType": "This is a very long service type name that exceeds fifty characters and should be rejected",
    "timeSlots": ["09:00", "13:00"]
}

# ===================================================================
# SERVICE TYPE RETRIEVAL
# ===================================================================

### 12. Get All Service Types (Public)
GET {{baseUrl}}/services/types

### 13. Get Service Types with New Types Created
GET {{baseUrl}}/services/types

# ===================================================================
# EDGE CASES AND ERROR SCENARIOS
# ===================================================================

### 14. Initialize with Invalid Service Types Format - Service Provider
POST {{baseUrl}}/services/initialize
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "serviceTypes": "invalid_format"
}

### 15. Initialize with Empty Service Types Array - Service Provider
POST {{baseUrl}}/services/initialize
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "serviceTypes": []
}

### 16. Submit Service with Duplicate ServiceType - Service Provider (Should Handle Gracefully)
POST {{baseUrl}}/services
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Another Mobile Grooming",
    "price": 180000,
    "description": "Another mobile grooming service",
    "duration": "1 hour",
    "serviceType": "Mobile Grooming",
    "timeSlots": ["11:00", "16:00"]
}

### 17. Submit Service with Non-existent TypeID - Service Provider (DENIED)
POST {{baseUrl}}/services
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Mystery Service",
    "price": 120000,
    "description": "Service with non-existent type ID",
    "duration": "1 hour",
    "typeid": 999999,
    "timeSlots": ["10:00", "14:00"]
}
