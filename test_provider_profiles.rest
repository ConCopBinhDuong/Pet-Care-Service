# ### Service Provider Profile Viewing API Tests
# ### Tests for pet owners and managers to view service provider profiles
# ### Make sure server is running on HTTPS (port 8443)

# @baseUrl = https://localhost:8443/api
# @petOwnerEmail = john.petowner@example.com
# @petOwnerPassword = SecurePass123!
# @managerEmail = manager@petcare.com 
# @managerPassword = AdminPass123!

# # ===================================================================
# # AUTHENTICATION - Get tokens for testing
# # ===================================================================

# ### 1. Login as Pet Owner
# POST {{baseUrl}}/auth/login
# Content-Type: application/json

# {
#     "email": "{{petOwnerEmail}}",
#     "password": "{{petOwnerPassword}}"
# }

# ### 2. Login as Manager  
# POST {{baseUrl}}/auth/login
# Content-Type: application/json

# {
#     "email": "{{managerEmail}}",
#     "password": "{{managerPassword}}"
# }

# # ===================================================================
# # SERVICE PROVIDER PROFILE VIEWING TESTS
# # ===================================================================

# ### 3. Get All Service Providers (Pet Owner)
# GET {{baseUrl}}/profile/providers
# Authorization: Bearer {{petOwnerToken}}

# ### 4. Get All Service Providers with Search Filter (Pet Owner)
# GET {{baseUrl}}/profile/providers?search=pet care&hasServices=true
# Authorization: Bearer {{petOwnerToken}}

# ### 5. Get All Service Providers with City Filter (Pet Owner)
# GET {{baseUrl}}/profile/providers?city=Ho Chi Minh&minRating=3
# Authorization: Bearer {{petOwnerToken}}

# ### 6. Get All Service Providers with Service Type Filter (Pet Owner)
# GET {{baseUrl}}/profile/providers?serviceType=grooming
# Authorization: Bearer {{petOwnerToken}}

# ### 7. Get Specific Service Provider Profile by ID (Pet Owner)
# GET {{baseUrl}}/profile/provider/2
# Authorization: Bearer {{petOwnerToken}}

# ### 8. Get All Service Providers (Manager)
# GET {{baseUrl}}/profile/providers
# Authorization: Bearer {{managerToken}}

# ### 9. Get Specific Service Provider Profile by ID (Manager)
# GET {{baseUrl}}/profile/provider/2
# Authorization: Bearer {{managerToken}}

# # ===================================================================
# # ACCESS CONTROL TESTS - These should fail
# # ===================================================================

# ### 10. Try to access as Service Provider (Should fail)
# GET {{baseUrl}}/profile/providers
# Authorization: Bearer {{serviceProviderToken}}

# ### 11. Try to access provider profile as Service Provider (Should fail)
# GET {{baseUrl}}/profile/provider/2
# Authorization: Bearer {{serviceProviderToken}}

# ### 12. Try to access without authentication (Should fail)
# GET {{baseUrl}}/profile/providers

# ### 13. Try to access provider profile without authentication (Should fail)  
# GET {{baseUrl}}/profile/provider/2

# ### 14. Try to access invalid provider ID (Should fail)
# GET {{baseUrl}}/profile/provider/999
# Authorization: Bearer {{petOwnerToken}}

# ### 15. Try to access with invalid provider ID format (Should fail)
# GET {{baseUrl}}/profile/provider/abc
# Authorization: Bearer {{petOwnerToken}}

# # ===================================================================
# # ADVANCED SEARCH TESTS
# # ===================================================================

# ### 16. Search by Business Name
# GET {{baseUrl}}/profile/providers?search=premium
# Authorization: Bearer {{petOwnerToken}}

# ### 17. Filter by Multiple Criteria
# GET {{baseUrl}}/profile/providers?search=care&city=saigon&minRating=4&hasServices=true
# Authorization: Bearer {{petOwnerToken}}

# ### 18. Get Providers in Specific City
# GET {{baseUrl}}/profile/providers?city=hanoi
# Authorization: Bearer {{managerToken}}

# ### 19. Get High-Rated Providers Only
# GET {{baseUrl}}/profile/providers?minRating=4.5
# Authorization: Bearer {{managerToken}}

# ### 20. Get Providers with Services Only
# GET {{baseUrl}}/profile/providers?hasServices=true
# Authorization: Bearer {{petOwnerToken}}

# # ===================================================================
# # PROFILE DETAILS TESTS  
# # ===================================================================

# ### 21. Get Complete Provider Profile with Statistics
# GET {{baseUrl}}/profile/provider/3
# Authorization: Bearer {{petOwnerToken}}

# ### 22. Manager Viewing Provider Profile  
# GET {{baseUrl}}/profile/provider/3
# Authorization: Bearer {{managerToken}}

