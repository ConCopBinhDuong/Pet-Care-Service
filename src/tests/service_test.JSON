{
  "info": {
    "_postman_id": "services-test-collection",
    "name": "Pet Care Service - Services Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Service Provider Operations",
      "item": [
        {
          "name": "Create Service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serviceProviderToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Pet Grooming\",\n    \"price\": 50.00,\n    \"description\": \"Professional grooming service\",\n    \"duration\": \"01:30\",\n    \"typeid\": 1,\n    \"timeSlots\": [\"09:00\", \"10:30\", \"13:00\", \"14:30\"]\n}"
            },
            "url": "{{baseUrl}}/api/services"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Service created successfully\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Service created successfully');",
                  "    pm.expect(jsonData.service).to.have.property('serviceid');",
                  "    pm.environment.set(\"testServiceId\", jsonData.service.serviceid);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Service - Invalid Data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serviceProviderToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"\",\n    \"price\": -50,\n    \"duration\": \"invalid\"\n}"
            },
            "url": "{{baseUrl}}/api/services"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Validation errors present\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "    pm.expect(jsonData.errors).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Get Services",
      "item": [
        {
          "name": "Get All Services",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{petOwnerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/services"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns array of services\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.services).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Service by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{petOwnerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/services/{{testServiceId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service details are correct\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.service).to.have.property('name');",
                  "    pm.expect(jsonData.service).to.have.property('price');",
                  "    pm.expect(jsonData.service).to.have.property('timeSlots');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Update Service",
      "item": [
        {
          "name": "Update Service Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serviceProviderToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Updated Pet Grooming\",\n    \"price\": 60.00,\n    \"description\": \"Updated description\",\n    \"timeSlots\": [\"10:00\", \"11:30\", \"14:00\"]\n}"
            },
            "url": "{{baseUrl}}/api/services/{{testServiceId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service updated successfully\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('updated');",
                  "    pm.expect(jsonData.service.name).to.eql('Updated Pet Grooming');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Delete Service",
      "item": [
        {
          "name": "Delete Service",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serviceProviderToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/services/{{testServiceId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service deleted successfully\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('deleted');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Service Deleted",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{serviceProviderToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/services/{{testServiceId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "pm.environment.set(\"baseUrl\", \"https://localhost:8443\");"
        ]
      }
    }
  ]
}