      "name": "Service Provider - Check Availability (Not Provider Role)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const today = new Date();",
              "const date = today.toISOString().split('T')[0];",
              "pm.variables.set('testDate', date);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403\", function () {",
              "  pm.response.to.have.status(403);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test(\"Access denied message\", function () {",
              "  pm.expect(jsonData.message).to.include('Access denied');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" }
        ],
        "url": "{{baseUrl}}/api/bookings/provider/availability/{{serviceId}}/{{testDate}}"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:8443", "type": "string" },
    { "key": "petOwnerToken", "value": "", "type": "string" },
    { "key": "serviceProviderToken", "value": "", "type": "string" },
    { "key": "serviceId", "value": "1", "type": "string" },
    { "key": "petId", "value": "1", "type": "string" },
    { "key": "bookingId", "value": "1", "type": "string" }
  ]
}