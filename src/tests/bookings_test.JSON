{
  "info": {
    "name": "Pet Care Service - Bookings API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Pet Owner - Create Booking (Success)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const bookingData = {",
              "  serviceid: parseInt(pm.environment.get('serviceId')),",
              "  slot: \"09:00\",",
              "  servedate: \"2025-07-01\",",
              "  payment_method: \"Credit Card\",",
              "  petIds: [parseInt(pm.environment.get('petId'))]",
              "};",
              "pm.variables.set('bookingData', JSON.stringify(bookingData));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test(\"Booking created successfully\", function () {",
              "  pm.expect(jsonData.booking).to.have.property('bookingId');",
              "  pm.environment.set('bookingId', jsonData.booking.bookingId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{{bookingData}}"
        }
      }
    },
