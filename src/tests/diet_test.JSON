{
  "info": {
    "name": "Pet Care Service - Diet Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Diet for Pet",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const dietData = {",
              "  name: \"Morning Kibble\",",
              "  amount: \"100g\",",
              "  description: \"Dry kibble for breakfast\"",
              "};",
              "pm.variables.set('dietData', JSON.stringify(dietData));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test(\"Diet created successfully\", function () {",
              "  pm.expect(jsonData.message).to.include('Diet added successfully');",
              "  pm.expect(jsonData.diet).to.have.property('dietid');",
              "  pm.environment.set('dietId', jsonData.diet.dietid);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/diet/pet/{{petId}}",
        "body": {
          "mode": "raw",
          "raw": "{{dietData}}"
        }
      }
    },
    {
      "name": "Get All Diets for Pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test(\"Diets retrieved for pet\", function () {",
              "  pm.expect(jsonData.petId).to.eql(parseInt(pm.variables.get('petId')));",
              "  pm.expect(jsonData.diets).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" }
        ],
        "url": "{{baseUrl}}/api/diet/pet/{{petId}}"
      }
    },
    {
      "name": "Get All Diets for User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test(\"All diets retrieved\", function () {",
              "  pm.expect(jsonData.diets).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" }
        ],
        "url": "{{baseUrl}}/api/diet"
      }
    },
    {
      "name": "Get Diet by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test(\"Diet details correct\", function () {",
              "  pm.expect(jsonData.diet).to.have.property('dietid');",
              "  pm.expect(jsonData.diet.dietid).to.eql(parseInt(pm.environment.get('dietId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" }
        ],
        "url": "{{baseUrl}}/api/diet/{{dietId}}"
      }
    },
    {
      "name": "Update Diet",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const updateData = {",
              "  name: \"Morning Kibble Updated\",",
              "  amount: \"120g\",",
              "  description: \"Updated breakfast portion\"",
              "};",
              "pm.variables.set('updateDietData', JSON.stringify(updateData));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test(\"Diet updated successfully\", function () {",
              "  pm.expect(jsonData.message).to.include('Diet updated successfully');",
              "  pm.expect(jsonData.diet.name).to.eql('Morning Kibble Updated');",
              "  pm.expect(jsonData.diet.amount).to.eql('120g');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/diet/{{dietId}}",
        "body": {
          "mode": "raw",
          "raw": "{{updateDietData}}"
        }
      }
    },
    {
      "name": "Delete Diet",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test(\"Diet deleted successfully\", function () {",
              "  pm.expect(jsonData.message).to.include('Diet deleted successfully');",
              "  pm.expect(jsonData.deletedDiet.id).to.eql(parseInt(pm.environment.get('dietId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" }
        ],
        "url": "{{baseUrl}}/api/diet/{{dietId}}"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:8443", "type": "string" },
    { "key": "petOwnerToken", "value": "", "type": "string" },
    { "key": "petId", "value": "1", "type": "string" }
  ]
}