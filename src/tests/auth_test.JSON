{
  "info": {
    "_postman_id": "auth-test-collection",
    "name": "Pet Care Service - Auth Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Registration Tests",
      "item": [
        {
          "name": "Register Pet Owner - Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"password\": \"Password123\",\n    \"gender\": \"Male\",\n    \"role\": \"Pet owner\",\n    \"phone\": \"+84123456789\",\n    \"city\": \"Ho Chi Minh\",\n    \"address\": \"123 Main St\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Registration successful\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.user.role).to.eql('Pet owner');",
                  "    pm.expect(jsonData.token).to.exist;",
                  "    pm.environment.set(\"petOwnerToken\", jsonData.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
