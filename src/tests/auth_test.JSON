              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"John Doe 2\",\n    \"email\": \"john@example.com\",\n    \"password\": \"Password123\",\n    \"gender\": \"Male\",\n    \"role\": \"Pet owner\",\n    \"phone\": \"+84123456780\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
