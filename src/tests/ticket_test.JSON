{
  "info": {
    "name": "Pet Care Service - Ticket API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Open Ticket",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/ticket/booking/1/open",
        "body": {
          "mode": "raw",
          "raw": "{\"subject\": \"Service Issue\", \"description\": \"My pet was not picked up on time.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Ticket opened successfully\", function () { pm.expect(pm.response.json().message).to.include('Ticket opened successfully'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "User Reply (Pet Owner)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/ticket/1/reply-user",
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"Thank you for your response.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Reply sent successfully\", function () { pm.expect(pm.response.json().message).to.include('Reply sent successfully'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Manager Initial Reply (Pending → Solving)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{managerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/ticket/1/reply",
        "body": {
          "mode": "raw",
          "raw": "{\"response\": \"We are looking into your issue.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Ticket replied successfully\", function () { pm.expect(pm.response.json().message).to.include('Ticket replied successfully'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Manager Threaded Reply (Solving)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{managerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/ticket/1/reply-manager",
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"Please provide more details.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Manager reply sent successfully\", function () { pm.expect(pm.response.json().message).to.include('Manager reply sent successfully'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Close Ticket",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{managerToken}}" }
        ],
        "url": "{{baseUrl}}/api/ticket/1/close"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Ticket closed successfully\", function () { pm.expect(pm.response.json().message).to.include('Ticket closed successfully'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Archived Tickets",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" }
        ],
        "url": "{{baseUrl}}/api/ticket/archived"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Archived tickets array exists\", function () { pm.expect(pm.response.json().archivedTickets).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Ticket Replies",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" }
        ],
        "url": "{{baseUrl}}/api/ticket/1/replies"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Replies array exists\", function () { pm.expect(pm.response.json().replies).to.be.an('array'); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:8443", "type": "string" },
    { "key": "managerToken", "value": "", "type": "string" },
    { "key": "petOwnerToken", "value": "", "type": "string" }
  ]
}