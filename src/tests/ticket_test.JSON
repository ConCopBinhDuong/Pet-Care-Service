          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/ticket/booking/99999/open",
            "body": {
              "mode": "raw",
              "raw": "{\"subject\": \"Invalid\", \"description\": \"Booking does not exist.\"}"
            }
          },
          "event": [
            {
              "listen": "test",
