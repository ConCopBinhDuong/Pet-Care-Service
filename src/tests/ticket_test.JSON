                ]
              }
            }
          ]
        },
        {
          "name": "Close non-existent ticket (not found)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": "{{baseUrl}}/api/ticket/99999/close"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Ticket not found\", function () { pm.expect(pm.response.json().message).to.include('Ticket not found'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Close ticket not in solving status (bad request)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": "{{baseUrl}}/api/ticket/204/close"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Only tickets in 'solving' status\", function () { pm.expect(pm.response.json().message).to.include('Only tickets in \"solving\" status'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Archived",
      "item": [
        {
          "name": "Get archived tickets (success)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" }
            ],
            "url": "{{baseUrl}}/api/ticket/archived"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Archived tickets array exists\", function () { pm.expect(pm.response.json().archivedTickets).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Open",
      "item": [
        {
          "name": "Pet owner opens ticket for booking (success)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/ticket/booking/301/open",
            "body": {
              "mode": "raw",
              "raw": "{\"subject\": \"Service Issue\", \"description\": \"My pet was not picked up on time.\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Ticket opened successfully\", function () { pm.expect(pm.response.json().message).to.include('Ticket opened successfully'); });"
                ]
              }
            }
          ]
        },
