{
  "info": {
    "name": "Pet Care Service - Ticket API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Reply",
      "item": [
        {
          "name": "Manager replies to pending ticket (success)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/ticket/201/reply",
            "body": {
              "mode": "raw",
              "raw": "{\"response\": \"We are looking into your issue.\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Ticket replied successfully\", function () { pm.expect(pm.response.json().message).to.include('Ticket replied successfully'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Non-manager tries to reply (forbidden)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/ticket/201/reply",
            "body": {
              "mode": "raw",
              "raw": "{\"response\": \"I want to reply as a pet owner.\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Access denied\", function () { pm.expect(pm.response.json().message).to.include('Access denied'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reply to non-existent ticket (not found)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/ticket/99999/reply",
            "body": {
              "mode": "raw",
              "raw": "{\"response\": \"Trying to reply to a non-existent ticket.\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Ticket not found\", function () { pm.expect(pm.response.json().message).to.include('Ticket not found'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reply to non-pending ticket (bad request)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/ticket/202/reply",
            "body": {
              "mode": "raw",
              "raw": "{\"response\": \"Trying to reply to a closed ticket.\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Only pending tickets\", function () { pm.expect(pm.response.json().message).to.include('Only pending tickets'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
