{
  "info": {
    "name": "Pet Care Service - Schedule Dashboard Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Pet Owner - Get Schedule Dashboard",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test(\"Dashboard object exists\", function () {",
              "  pm.expect(jsonData.dashboard).to.exist;",
              "  pm.expect(jsonData.dashboard).to.have.property('appointments');",
              "  pm.expect(jsonData.dashboard).to.have.property('statistics');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" }
        ],
        "url": "{{baseUrl}}/api/schedule/dashboard"
      }
    },
