    {
      "name": "General - Create Schedule Entry",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const now = new Date();",
              "now.setMinutes(now.getMinutes() + 10);",
              "const scheduled_time = now.toISOString();",
              "const scheduleData = {",
              "  scheduled_time: scheduled_time,",
              "  title: \"Vet Appointment\",",
              "  detail: \"Annual checkup for Max\"" ,
              "};",
              "pm.variables.set('generalScheduleData', JSON.stringify(scheduleData));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test(\"Schedule entry created\", function () {",
              "  pm.expect(jsonData.schedule).to.exist;",
              "  pm.expect(jsonData.schedule).to.have.property('scheduleid');",
              "  pm.environment.set('generalScheduleId', jsonData.schedule.scheduleid);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{petOwnerToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/schedule/create",
        "body": {
          "mode": "raw",
          "raw": "{{generalScheduleData}}"
        }
      }
    },
