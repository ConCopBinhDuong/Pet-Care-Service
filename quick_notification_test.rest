# ===================================================================
# STEP 2: BASIC NOTIFICATION TESTS (Paste tokens above first)
# ===================================================================

### 4. Test Health Check (Should work without token)
GET https://localhost:8443/health

### 5. Get Notifications - Should return empty array initially
GET {{baseUrl}}/notifications
Authorization: Bearer {{petOwnerToken}}

### 6. Get Notification Stats - Should show zero counts initially
GET {{baseUrl}}/notifications/stats
Authorization: Bearer {{petOwnerToken}}

### 7. Test Manual Schedule Check (Should work but create no notifications yet)
POST {{baseUrl}}/notifications/check-schedules
Authorization: Bearer {{managerToken}}

### 8. Test Admin Stats (Manager only)
GET {{baseUrl}}/notifications/admin/stats
Authorization: Bearer {{managerToken}}

# ===================================================================
# STEP 3: CREATE TEST SCENARIO TO TRIGGER NOTIFICATIONS
# ===================================================================

### 9. Submit a Service (Service Provider) - No notification yet
POST {{baseUrl}}/services/submit
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Quick Test Grooming Service",
    "price": 100,
    "description": "Test service for notification system",
    "duration": "1 hour",
    "typeid": 1,
    "timeSlots": ["10:00", "14:00"]
}

### 10. Approve the Service (Manager) - Should trigger notification
POST {{baseUrl}}/services/1/review
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
    "action": "approve"
}

### 11. Check Service Provider Notifications (Should see approval notification)
GET {{baseUrl}}/notifications
Authorization: Bearer {{serviceProviderToken}}

### 12. Create a Booking (Pet Owner) - Should trigger provider notification
POST {{baseUrl}}/bookings
Authorization: Bearer {{petOwnerToken}}
Content-Type: application/json

{
    "serviceid": 1,
    "slot": "10:00",
    "servedate": "2025-06-15",
    "payment_method": "cash",
    "petIds": [1]
}

### 13. Check Service Provider Notifications (Should see booking request)
GET {{baseUrl}}/notifications
Authorization: Bearer {{serviceProviderToken}}

### 14. Accept the Booking (Service Provider) - Should trigger pet owner notification
POST {{baseUrl}}/bookings/provider/requests/1/accept
Authorization: Bearer {{serviceProviderToken}}

### 15. Check Pet Owner Notifications (Should see booking accepted)
GET {{baseUrl}}/notifications
Authorization: Bearer {{petOwnerToken}}

# ===================================================================
# STEP 4: TEST NOTIFICATION MANAGEMENT
# ===================================================================

### 16. Mark First Notification as Read (Replace 1 with actual notification ID)
PUT {{baseUrl}}/notifications/1/read
Authorization: Bearer {{petOwnerToken}}

### 17. Check Updated Stats
GET {{baseUrl}}/notifications/stats
Authorization: Bearer {{petOwnerToken}}

### 18. Mark All Notifications as Read
PUT {{baseUrl}}/notifications/read-all
Authorization: Bearer {{serviceProviderToken}}

### 19. Final System Stats Check
GET {{baseUrl}}/notifications/admin/stats
Authorization: Bearer {{managerToken}}

