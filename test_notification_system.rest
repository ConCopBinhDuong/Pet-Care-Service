# ===================================================================
# INTEGRATION TESTS - CREATE SCENARIOS TO TRIGGER NOTIFICATIONS
# ===================================================================

### 22. Submit a Service (Service Provider) - Should NOT trigger notification yet
POST {{baseUrl}}/services/submit
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Test Pet Grooming Service",
    "price": 50,
    "description": "Professional pet grooming service",
    "duration": "2 hours",
    "typeid": 1,
    "timeSlots": ["09:00", "11:00", "14:00", "16:00"]
}

### 23. Approve the Service (Manager) - Should trigger service_approved notification
POST {{baseUrl}}/services/1/review
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
    "action": "approve"
}

### 24. Check Service Provider Notifications (Should see approval notification)
GET {{baseUrl}}/notifications?type=service_approved
Authorization: Bearer {{serviceProviderToken}}

### 25. Submit Another Service to Reject
POST {{baseUrl}}/services/submit
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "name": "Test Pet Training Service",
    "price": 75,
    "description": "Basic pet training",
    "duration": "1 hour",
    "typeid": 2,
    "timeSlots": ["10:00", "15:00"]
}

### 26. Reject the Service (Manager) - Should trigger service_rejected notification
POST {{baseUrl}}/services/2/review
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
    "action": "reject",
    "rejectionReason": "Service description needs more detail about training methods"
}

### 27. Check Service Provider Notifications (Should see rejection notification)
GET {{baseUrl}}/notifications?type=service_rejected
Authorization: Bearer {{serviceProviderToken}}

### 28. Create a Booking (Pet Owner) - Should trigger booking_request notification
POST {{baseUrl}}/bookings
Authorization: Bearer {{petOwnerToken}}
Content-Type: application/json

{
    "serviceid": 1,
    "slot": "09:00",
    "servedate": "2025-06-15",
    "payment_method": "cash",
    "petIds": [1]
}

### 29. Check Service Provider Notifications (Should see booking request notification)
GET {{baseUrl}}/notifications?type=booking_request
Authorization: Bearer {{serviceProviderToken}}

### 30. Accept the Booking (Service Provider) - Should trigger booking_accepted notification
POST {{baseUrl}}/bookings/provider/requests/1/accept
Authorization: Bearer {{serviceProviderToken}}

### 31. Check Pet Owner Notifications (Should see booking accepted notification)
GET {{baseUrl}}/notifications?type=booking_accepted
Authorization: Bearer {{petOwnerToken}}

### 32. Create Another Booking to Reject
POST {{baseUrl}}/bookings
Authorization: Bearer {{petOwnerToken}}
Content-Type: application/json

{
    "serviceid": 1,
    "slot": "11:00",
    "servedate": "2025-06-16",
    "payment_method": "cash",
    "petIds": [1]
}

### 33. Reject the Booking (Service Provider) - Should trigger booking_rejected notification
POST {{baseUrl}}/bookings/provider/requests/2/reject
Authorization: Bearer {{serviceProviderToken}}
Content-Type: application/json

{
    "reason": "Schedule conflict with another appointment"
}

### 34. Check Pet Owner Notifications (Should see booking rejected notification)
GET {{baseUrl}}/notifications?type=booking_rejected
Authorization: Bearer {{petOwnerToken}}

