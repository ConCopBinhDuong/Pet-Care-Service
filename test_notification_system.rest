# ===================================================================
# SETUP - LOGIN TO GET TOKENS (Run these first)
# ===================================================================

### 1. Login as Pet Owner
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "petowner@example.com",
    "password": "password123"
}

### 2. Login as Service Provider
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "provider@example.com",
    "password": "password123"
}

### 3. Login as Manager
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "manager@example.com",
    "password": "password123"
}

# ===================================================================
# NOTIFICATION RETRIEVAL ENDPOINTS
# ===================================================================

### 4. Get All Notifications (Pet Owner)
GET {{baseUrl}}/notifications
Authorization: Bearer {{petOwnerToken}}

### 5. Get Notifications with Pagination
GET {{baseUrl}}/notifications?page=1&limit=10
Authorization: Bearer {{petOwnerToken}}

### 6. Get Unread Notifications Only
GET {{baseUrl}}/notifications?unreadOnly=true
Authorization: Bearer {{petOwnerToken}}

### 7. Get Notifications by Type - Diet
GET {{baseUrl}}/notifications?type=diet
Authorization: Bearer {{petOwnerToken}}

### 8. Get Notifications by Type - Service Approved
GET {{baseUrl}}/notifications?type=service_approved
Authorization: Bearer {{serviceProviderToken}}

### 9. Get Notifications by Type - Booking Request
GET {{baseUrl}}/notifications?type=booking_request
Authorization: Bearer {{serviceProviderToken}}

### 10. Get Notification Statistics (Pet Owner)
GET {{baseUrl}}/notifications/stats
Authorization: Bearer {{petOwnerToken}}

### 11. Get Notification Statistics (Service Provider)
GET {{baseUrl}}/notifications/stats
Authorization: Bearer {{serviceProviderToken}}

# ===================================================================
# NOTIFICATION MANAGEMENT ENDPOINTS
# ===================================================================

### 12. Mark Notification as Read (use notification ID from previous calls)
PUT {{baseUrl}}/notifications/1/read
Authorization: Bearer {{petOwnerToken}}

### 13. Mark All Notifications as Read
PUT {{baseUrl}}/notifications/read-all
Authorization: Bearer {{petOwnerToken}}

### 14. Delete a Notification (use notification ID from previous calls)
DELETE {{baseUrl}}/notifications/1
Authorization: Bearer {{petOwnerToken}}

